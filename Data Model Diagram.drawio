                <!-- =========================================== -->
                <mxCell id="table_users" value="&lt;b&gt;USERS&lt;/b&gt;&lt;br&gt;-------------------&lt;br&gt;PK | &lt;b&gt;user_id&lt;/b&gt; INT&lt;br&gt;   | username VARCHAR(50)&lt;br&gt;   | email VARCHAR(100)&lt;br&gt;   | password_hash VARCHAR(255)&lt;br&gt;   | phone VARCHAR(15)&lt;br&gt;   | user_type ENUM('customer','seller','admin')&lt;br&gt;   | created_at TIMESTAMP&lt;br&gt;   | updated_at TIMESTAMP&lt;br&gt;   | is_active BOOLEAN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;" vertex="1" parent="1">
