                <mxCell id="note1" value="&lt;b&gt;Database Notes:&lt;/b&gt;&lt;br&gt;1. PK = Primary Key&lt;br&gt;2. FK = Foreign Key&lt;br&gt;3. All tables have created_at/updated_at&lt;br&gt;4. Indexes on foreign keys&lt;br&gt;5. Composite PK for some tables&lt;br&gt;6. Cascade delete for relationships" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=fill;fontSize=12;" vertex="1" parent="1">
                    <mxGeometry x="50" y="900" width="300" height="100" as="geometry" />
                </mxCell>
                
                <mxCell id="note2" value="&lt;b&gt;Important Indexes:&lt;/b&gt;&lt;br&gt;• products(category_id)&lt;br&gt;• products(seller_id)&lt;br&gt;• orders(customer_id)&lt;br&gt;• orders(status)&lt;br&gt;• order_items(order_id)&lt;br&gt;• reviews(product_id, rating)&lt;br&gt;• payments(order_id)&lt;br&gt;• cart_items(cart_id)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=fill;fontSize=12;" vertex="1" parent="1">
                    <mxGeometry x="400" y="1050" width="300" height="100" as="geometry" />
                </mxCell>
                
            </root>
        </mxGraphModel>
