                    <mxGeometry x="600" y="50" width="100" height="700" as="geometry" />
                </mxCell>
                
                <!-- =========================================== -->
                <!-- LIFELINES (Vertical Lines) -->
                <!-- =========================================== -->
                <mxCell id="lifeline_customer" style="line;strokeWidth=1;fillColor=none;html=1;points=[];" vertex="1" parent="1">
                    <mxGeometry x="70" y="140" width="10" height="580" as="geometry" />
                </mxCell>
                
                <mxCell id="lifeline_webapp" style="line;strokeWidth=1;fillColor=none;html=1;points=[];" vertex="1" parent="1">
                    <mxGeometry x="200" y="140" width="10" height="580" as="geometry" />
                </mxCell>
                
                <mxCell id="lifeline_database" style="line;strokeWidth=1;fillColor=none;html=1;points=[];" vertex="1" parent="1">
                    <mxGeometry x="350" y="140" width="10" height="580" as="geometry" />
                </mxCell>
                
                <mxCell id="lifeline_payment" style="line;strokeWidth=1;fillColor=none;html=1;points=[];" vertex="1" parent="1">
                    <mxGeometry x="500" y="140" width="10" height="580" as="geometry" />
