                <mxCell id="msg14" value="14. proceedToCheckout()" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="participant_customer" target="participant_webapp">
