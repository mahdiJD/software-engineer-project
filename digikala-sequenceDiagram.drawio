    <diagram name="Sequence Diagram - Order Process" id="sequence-diagram-digikala">
        <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="800">
            <root>
                <!-- Base cells -->
                <mxCell id="0" />
                <mxCell id="1" parent="0" />
                
                <!-- =========================================== -->
                <!-- PARTICIPANTS (From Left to Right) -->
                <!-- =========================================== -->
                
                <!-- 1. Customer -->
                <mxCell id="participant_customer" value="Customer" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;align=center;" vertex="1" parent="1">
                    <mxGeometry x="50" y="50" width="40" height="80" as="geometry" />
                </mxCell>
                
                <!-- 2. Web Application -->
                <mxCell id="participant_webapp" value="Web Application" style="swimlane;fontStyle=1;align=center;verticalAlign=top;html=1;" vertex="1" parent="1">
                    <mxGeometry x="150" y="50" width="100" height="700" as="geometry" />
                </mxCell>
                
                <!-- 3. Database -->
