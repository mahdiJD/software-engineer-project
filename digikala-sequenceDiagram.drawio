                <mxCell id="lifeline_seller" style="line;strokeWidth=1;fillColor=none;html=1;points=[];" vertex="1" parent="1">
                    <mxGeometry x="650" y="140" width="10" height="580" as="geometry" />
                </mxCell>
                
                <!-- =========================================== -->
                <!-- SECTION 1: BROWSE & SELECT PRODUCTS -->
                <!-- =========================================== -->
                
                <!-- Message 1: Browse Products -->
                <mxCell id="msg1" value="1. browseProducts()" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="participant_customer" target="participant_webapp">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="70" y="150" as="sourcePoint" />
                        <mxPoint x="200" y="150" as="targetPoint" />
                    </mxGeometry>
                </mxCell>
                
                <!-- Message 2: Search Products -->
                <mxCell id="msg2" value="2. searchProducts(criteria)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="participant_customer" target="participant_webapp">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="70" y="170" as="sourcePoint" />
                        <mxPoint x="200" y="170" as="targetPoint" />
                    </mxGeometry>
                </mxCell>
                
                <!-- Message 3: Get Products from DB -->
