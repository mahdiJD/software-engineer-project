<mxfile host="app.diagrams.net">
  <diagram id="activityDiagram1" name="Activity Diagram">
    <mxGraphModel dx="1280" dy="720" grid="1" gridSize="10">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Start -->
        <mxCell id="start" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000" vertex="1" parent="1">
          <mxGeometry x="100" y="60" width="30" height="30" as="geometry"/>
        </mxCell>

        <!-- Actions -->
        <mxCell id="browse" value="Browse Products" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="130" width="150" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="select" value="Select Product" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="210" width="150" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="add_to_cart" value="Add to Cart" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="290" width="150" height="50" as="geometry"/>
        </mxCell>

        <!-- Decision: Cart Checkout? -->
        <mxCell id="decision_checkout" value="" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="370" width="130" height="80" as="geometry"/>
        </mxCell>
        
        <mxCell id="checkout_text" value="Proceed to Checkout?" style="text;html=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="90" y="385" width="100" height="50" as="geometry"/>
        </mxCell>

        <!-- Continue Shopping -->
        <mxCell id="continue" value="Continue Shopping" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="260" y="290" width="150" height="50" as="geometry"/>
        </mxCell>

        <!-- Checkout -->
        <mxCell id="checkout" value="Checkout" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="480" width="150" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="payment" value="Make Online Payment" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="560" width="150" height="50" as="geometry"/>
        </mxCell>

        <!-- Decision: Payment Success? -->
        <mxCell id="decision_payment" value="" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="640" width="130" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="payment_text" value="Payment Successful?" style="text;html=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="90" y="655" width="100" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="retry" value="Retry Payment" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="260" y="560" width="150" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="order_complete" value="Order Completed" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="750" width="150" height="50" as="geometry"/>
        </mxCell>

        <!-- End -->
        <mxCell id="end" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000" vertex="1" parent="1">
          <mxGeometry x="100" y="840" width="30" height="30" as="geometry"/>
        </mxCell>


        <!-- Edges -->
        <mxCell id="e1" edge="1" source="start" target="browse"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" edge="1" source="browse" target="select"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" edge="1" source="select" target="add_to_cart"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="e4" edge="1" source="add_to_cart" target="decision_checkout"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="e5" edge="1" source="decision_checkout" target="continue">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e6" edge="1" source="decision_checkout" target="checkout">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e7" edge="1" source="checkout" target="payment"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" edge="1" source="payment" target="decision_payment"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="e9" edge="1" source="decision_payment" target="retry"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="e10" edge="1" source="decision_payment" target="order_complete">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e11" edge="1" source="order_complete" target="end">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
