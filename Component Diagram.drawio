                    <mxGeometry x="200" y="50" width="200" height="30" as="geometry" />
                </mxCell>
                
                <!-- Component 1: Web Frontend -->
                <mxCell id="comp_web_frontend" value="&lt;b&gt;Web Frontend&lt;/b&gt;&lt;br&gt;-------------------&lt;br&gt;&lt;i&gt;React/Vue.js&lt;/i&gt;&lt;br&gt;• Product Browsing&lt;br&gt;• Shopping Cart&lt;br&gt;• Checkout UI&lt;br&gt;• User Dashboard" style="shape=component;whiteSpace=wrap;html=1;fillColor=#dae8fc;" vertex="1" parent="1">
                    <mxGeometry x="150" y="100" width="180" height="180" as="geometry" />
