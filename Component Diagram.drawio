    <diagram name="Component Diagram - Digikala Architecture" id="component-diagram-digikala">
        <mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000">
            <root>
                <mxCell id="0" />
                <mxCell id="1" parent="0" />
                
                <!-- =========================================== -->
                <!-- EXTERNAL SYSTEMS -->
                <!-- =========================================== -->
                <mxCell id="external_user" value="&lt;b&gt;User&lt;/b&gt;&lt;br&gt;(Customer/Seller/Admin)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;align=center;" vertex="1" parent="1">
