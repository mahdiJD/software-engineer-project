                <!-- =========================================== -->
                <mxCell id="class_cart_item" value="&lt;b&gt;CartItem&lt;/b&gt;&lt;br&gt;------------------------&lt;br&gt;- id: int&lt;br&gt;- cartId: int&lt;br&gt;- productId: int&lt;br&gt;- quantity: int&lt;br&gt;- addedAt: datetime&lt;br&gt;------------------------&lt;br&gt;+ updateQuantity(qty): bool&lt;br&gt;+ calculateSubtotal(): decimal&lt;br&gt;+ getProduct(): Product" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;" vertex="1" parent="1">
                    <mxGeometry x="520" y="350" width="160" height="140" as="geometry" />
                </mxCell>
                
                <!-- =========================================== -->
                <!-- CLASS 9: ORDER -->
                <!-- =========================================== -->
                <mxCell id="class_order" value="&lt;b&gt;Order&lt;/b&gt;&lt;br&gt;------------------------&lt;br&gt;- id: int&lt;br&gt;- customerId: int&lt;br&gt;- orderNumber: string&lt;br&gt;- totalAmount: decimal(10,2)&lt;br&gt;- status: string&lt;br&gt;- shippingAddress: string&lt;br&gt;- orderDate: datetime&lt;br&gt;- estimatedDelivery: datetime&lt;br&gt;- trackingNumber: string&lt;br&gt;------------------------&lt;br&gt;+ calculateTotal(): decimal&lt;br&gt;+ updateStatus(newStatus): bool&lt;br&gt;+ cancelOrder(): bool&lt;br&gt;+ generateInvoice(): Invoice&lt;br&gt;+ getOrderItems(): OrderItem[]&lt;br&gt;+ addTracking(trackingNo): bool" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;" vertex="1" parent="1">
                    <mxGeometry x="300" y="580" width="200" height="210" as="geometry" />
                </mxCell>
                
                <!-- =========================================== -->
                <!-- CLASS 10: ORDER_ITEM -->
                <!-- =========================================== -->
                <mxCell id="class_order_item" value="&lt;b&gt;OrderItem&lt;/b&gt;&lt;br&gt;------------------------&lt;br&gt;- id: int&lt;br&gt;- orderId: int&lt;br&gt;- productId: int&lt;br&gt;- quantity: int&lt;br&gt;- unitPrice: decimal(10,2)&lt;br&gt;- subtotal: decimal(10,2)&lt;br&gt;------------------------&lt;br&gt;+ calculateSubtotal(): decimal&lt;br&gt;+ getProduct(): Product" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;" vertex="1" parent="1">
