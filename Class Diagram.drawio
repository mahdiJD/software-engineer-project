                        </Array>
                    </mxGeometry>
                </mxCell>
                
                <!-- =========================================== -->
                <!-- CLASS 5: PRODUCT -->
                <!-- =========================================== -->
                <mxCell id="class_product" value="&lt;b&gt;Product&lt;/b&gt;&lt;br&gt;------------------------&lt;br&gt;- id: int&lt;br&gt;- title: string&lt;br&gt;- description: string&lt;br&gt;- price: decimal(10,2)&lt;br&gt;- stockQuantity: int&lt;br&gt;- categoryId: int&lt;br&gt;- sellerId: int&lt;br&gt;- imageUrl: string&lt;br&gt;- rating: float&lt;br&gt;- createdAt: datetime&lt;br&gt;- updatedAt: datetime&lt;br&gt;------------------------&lt;br&gt;+ getFinalPrice(): decimal&lt;br&gt;+ updateStock(qty): bool&lt;br&gt;+ isAvailable(): bool&lt;br&gt;+ addToWishlist(userId): bool&lt;br&gt;+ calculateDiscount(): decimal&lt;br&gt;+ getSimilarProducts(): Product[]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;" vertex="1" parent="1">
                    <mxGeometry x="300" y="50" width="200" height="250" as="geometry" />
                </mxCell>
                
                <!-- =========================================== -->
                <!-- CLASS 6: CATEGORY -->
                <!-- =========================================== -->
                <mxCell id="class_category" value="&lt;b&gt;Category&lt;/b&gt;&lt;br&gt;------------------------&lt;br&gt;- id: int&lt;br&gt;- name: string&lt;br&gt;- parentId: int&lt;br&gt;- description: string&lt;br&gt;- slug: string&lt;br&gt;- imageUrl: string&lt;br&gt;------------------------&lt;br&gt;+ getSubCategories(): Category[]&lt;br&gt;+ getProducts(): Product[]&lt;br&gt;+ getParentCategory(): Category&lt;br&gt;+ countProducts(): int" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;" vertex="1" parent="1">
                    <mxGeometry x="550" y="50" width="180" height="160" as="geometry" />
                </mxCell>
                
                <!-- =========================================== -->
