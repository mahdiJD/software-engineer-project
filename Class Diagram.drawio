    <diagram name="Class Diagram - Digikala System" id="class-diagram-digikala">
        <mxGraphModel dx="1200" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1000">
            <root>
                <mxCell id="0" />
                <mxCell id="1" parent="0" />
                
                <!-- =========================================== -->
                <!-- CLASS 1: USER (Abstract Base Class) -->
                <!-- =========================================== -->
                <mxCell id="class_user" value="&lt;b&gt;User&lt;/b&gt;&lt;br&gt;------------------------&lt;br&gt;&lt;i&gt;&amp;lt;&amp;lt;abstract&amp;gt;&amp;gt;&lt;/i&gt;&lt;br&gt;------------------------&lt;br&gt;# id: int&lt;br&gt;# username: string&lt;br&gt;# email: string&lt;br&gt;# password: string&lt;br&gt;# phone: string&lt;br&gt;# createdAt: datetime&lt;br&gt;------------------------&lt;br&gt;+ login(username, password): bool&lt;br&gt;+ logout(): void&lt;br&gt;+ updateProfile(data): bool&lt;br&gt;# validatePassword(): bool" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;" vertex="1" parent="1">
                    <mxGeometry x="50" y="50" width="180" height="200" as="geometry" />
                </mxCell>
                
                <!-- =========================================== -->
                <!-- CLASS 2: CUSTOMER -->
                <!-- =========================================== -->
                <mxCell id="class_customer" value="&lt;b&gt;Customer&lt;/b&gt;&lt;br&gt;------------------------&lt;br&gt;+ address: string&lt;br&gt;+ city: string&lt;br&gt;+ postalCode: string&lt;br&gt;+ loyaltyPoints: int&lt;br&gt;------------------------&lt;br&gt;+ placeOrder(cart): Order&lt;br&gt;+ viewOrderHistory(): Order[]&lt;br&gt;+ addToCart(product, qty): bool&lt;br&gt;+ removeFromCart(productId): bool&lt;br&gt;+ updateShippingAddress(address): void&lt;br&gt;+ applyCoupon(code): bool" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;" vertex="1" parent="1">
                    <mxGeometry x="50" y="300" width="180" height="180" as="geometry" />
                </mxCell>
                
                <!-- =========================================== -->
                <!-- CLASS 3: SELLER -->
                <!-- =========================================== -->
                <mxCell id="class_seller" value="&lt;b&gt;Seller&lt;/b&gt;&lt;br&gt;------------------------&lt;br&gt;+ sellerCode: string&lt;br&gt;+ companyName: string&lt;br&gt;+ taxId: string&lt;br&gt;+ bankAccount: string&lt;br&gt;+ rating: float&lt;br&gt;------------------------&lt;br&gt;+ addProduct(product): bool&lt;br&gt;+ updateProduct(productId, data): bool&lt;br&gt;+ updateStock(productId, qty): bool&lt;br&gt;+ viewOrders(): Order[]&lt;br&gt;+ viewSalesReport(): Report&lt;br&gt;+ respondToReview(reviewId, response): bool" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;" vertex="1" parent="1">
                    <mxGeometry x="50" y="520" width="180" height="180" as="geometry" />
                </mxCell>
                
                <!-- =========================================== -->
                <!-- CLASS 4: ADMIN -->
                <!-- =========================================== -->
                <mxCell id="class_admin" value="&lt;b&gt;Admin&lt;/b&gt;&lt;br&gt;------------------------&lt;br&gt;+ adminLevel: string&lt;br&gt;+ department: string&lt;br&gt;+ permissions: string[]&lt;br&gt;------------------------&lt;br&gt;+ manageUsers(): User[]&lt;br&gt;+ manageProducts(): Product[]&lt;br&gt;+ generateReports(type): Report&lt;br&gt;+ banUser(userId): bool&lt;br&gt;+ approveSeller(sellerId): bool&lt;br&gt;+ viewSystemLogs(): Log[]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;" vertex="1" parent="1">
                    <mxGeometry x="50" y="740" width="180" height="180" as="geometry" />
                </mxCell>
                
                <!-- =========================================== -->
                <!-- INHERITANCE RELATIONSHIPS -->
                <!-- =========================================== -->
                <!-- Customer inherits from User -->
                <mxCell id="inherit_customer" value="" style="endArrow=block;endSize=8;html=1;endFill=1;" edge="1" parent="1" source="class_customer" target="class_user">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="140" y="300" />
                            <mxPoint x="140" y="250" />
                        </Array>
                    </mxGeometry>
                </mxCell>
                
                <!-- Seller inherits from User -->
                <mxCell id="inherit_seller" value="" style="endArrow=block;endSize=8;html=1;endFill=1;" edge="1" parent="1" source="class_seller" target="class_user">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="140" y="520" />
                            <mxPoint x="140" y="250" />
                        </Array>
                    </mxGeometry>
                </mxCell>
                
                <!-- Admin inherits from User -->
                <mxCell id="inherit_admin" value="" style="endArrow=block;endSize=8;html=1;endFill=1;" edge="1" parent="1" source="class_admin" target="class_user">
