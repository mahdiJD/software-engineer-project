                <!-- On-premise Servers -->
                <mxCell id="node_onprem" value="&lt;b&gt;On-premise Data Center&lt;/b&gt;&lt;br&gt;(Legacy Systems)" style="shape=server;whiteSpace=wrap;html=1;fillColor=#e1d5e7;" vertex="1" parent="1">
                    <mxGeometry x="1200" y="200" width="180" height="100" as="geometry" />
                </mxCell>
                
