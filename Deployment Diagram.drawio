                </mxCell>
                
                <!-- =========================================== -->
                <!-- CONNECTIONS: APPLICATION → DATABASE -->
                <!-- =========================================== -->
                
                <!-- Microservices → Primary DB -->
                <mxCell id="conn_db1" value="&lt;b&gt;PostgreSQL (5432)&lt;/b&gt;" style="endArrow=open;html=1;endSize=8;" edge="1" parent="1" source="app_microservices" target="db_primary">
                    <mxGeometry relative="1" as="geometry">
