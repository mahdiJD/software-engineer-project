                <mxCell id="legend2" value="&lt;b&gt;Security Measures&lt;/b&gt;&lt;br&gt;-------------------&lt;br&gt;• Network Segmentation&lt;br&gt;• Firewall Rules&lt;br&gt;• WAF Protection&lt;br&gt;• DDoS Mitigation&lt;br&gt;• SSL/TLS Encryption&lt;br&gt;• Regular Audits&lt;br&gt;• Penetration Testing&lt;br&gt;• Compliance (PCI DSS)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=fill;fontSize=12;" vertex="1" parent="1">
