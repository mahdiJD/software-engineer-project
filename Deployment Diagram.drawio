<mxfile host="app.diagrams.net" modified="2025-01-01T16:00:00.000Z" agent="Mozilla/5.0" version="29.2.4">
    <diagram name="Deployment Diagram - Digikala Infrastructure" id="deployment-diagram-digikala">
        <mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200">
            <root>
                <mxCell id="0" />
                <mxCell id="1" parent="0" />
                
                <!-- =========================================== -->
                <!-- NETWORK ZONES -->
                <!-- =========================================== -->
                
                <!-- Internet Zone -->
                <mxCell id="zone_internet" value="&lt;b&gt;Internet&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
                    <mxGeometry x="50" y="50" width="1400" height="100" as="geometry" />
                </mxCell>
                
                <!-- DMZ Zone -->
                <mxCell id="zone_dmz" value="&lt;b&gt;DMZ (Demilitarized Zone)&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
                    <mxGeometry x="50" y="170" width="1400" height="250" as="geometry" />
                </mxCell>
                
                <!-- Application Zone -->
                <mxCell id="zone_application" value="&lt;b&gt;Application Zone&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
                    <mxGeometry x="50" y="440" width="1400" height="350" as="geometry" />
                </mxCell>
                
                <!-- Database Zone -->
                <mxCell id="zone_database" value="&lt;b&gt;Database Zone&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
                    <mxGeometry x="50" y="810" width="1400" height="250" as="geometry" />
                </mxCell>
                
                <!-- =========================================== -->
                <!-- INTERNET ZONE COMPONENTS -->
                <!-- =========================================== -->
                
                <!-- Users -->
                <mxCell id="internet_users" value="&lt;b&gt;Users&lt;/b&gt;&lt;br&gt;(Customers, Sellers, Admins)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;align=center;" vertex="1" parent="1">
                    <mxGeometry x="100" y="70" width="40" height="80" as="geometry" />
                </mxCell>
                
                <!-- CDN -->
                <mxCell id="internet_cdn" value="&lt;b&gt;CDN&lt;/b&gt;&lt;br&gt;(Cloudflare/Akamai)&lt;br&gt;-------------------&lt;br&gt;• Static Content&lt;br&gt;• Image Cache&lt;br&gt;• DDoS Protection" style="shape=component;whiteSpace=wrap;html=1;fillColor=#e1d5e7;" vertex="1" parent="1">
                    <mxGeometry x="300" y="70" width="160" height="120" as="geometry" />
                </mxCell>
                
                <!-- External APIs -->
                <mxCell id="internet_apis" value="&lt;b&gt;External APIs&lt;/b&gt;&lt;br&gt;-------------------&lt;br&gt;• Bank Payment&lt;br&gt;• SMS Service&lt;br&gt;• Email Service&lt;br&gt;• Map Service" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;" vertex="1" parent="1">
                    <mxGeometry x="550" y="70" width="160" height="120" as="geometry" />
                </mxCell>
                
                <!-- =========================================== -->
                <!-- DMZ ZONE COMPONENTS -->
                <!-- =========================================== -->
                
                <!-- Load Balancer -->
                <mxCell id="dmz_load_balancer" value="&lt;b&gt;Load Balancer&lt;/b&gt;&lt;br&gt;(HAProxy/Nginx)&lt;br&gt;-------------------&lt;br&gt;• SSL Termination&lt;br&gt;• Load Distribution&lt;br&gt;• Health Checks" style="shape=component;whiteSpace=wrap;html=1;fillColor=#f5f5f5;" vertex="1" parent="1">
                    <mxGeometry x="200" y="220" width="180" height="140" as="geometry" />
                </mxCell>
                
                <!-- Web Servers -->
                <mxCell id="dmz_web_servers" value="&lt;b&gt;Web Servers&lt;/b&gt;&lt;br&gt;(Nginx/Apache)&lt;br&gt;-------------------&lt;br&gt;• Static Files&lt;br&gt;• Reverse Proxy&lt;br&gt;• Caching&lt;br&gt;• Compression" style="shape=component;whiteSpace=wrap;html=1;fillColor=#dae8fc;" vertex="1" parent="1">
                    <mxGeometry x="450" y="220" width="180" height="140" as="geometry" />
                </mxCell>
                
                <!-- WAF -->
                <mxCell id="dmz_waf" value="&lt;b&gt;WAF&lt;/b&gt;&lt;br&gt;(Web Application Firewall)&lt;br&gt;-------------------&lt;br&gt;• SQL Injection&lt;br&gt;• XSS Protection&lt;br&gt;• Rate Limiting&lt;br&gt;• Bot Detection" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;" vertex="1" parent="1">
                    <mxGeometry x="700" y="220" width="180" height="140" as="geometry" />
                </mxCell>
                
                <!-- API Gateway -->
                <mxCell id="dmz_api_gateway" value="&lt;b&gt;API Gateway&lt;/b&gt;&lt;br&gt;(Kong/Apigee)&lt;br&gt;-------------------&lt;br&gt;• Request Routing&lt;br&gt;• Authentication&lt;br&gt;• Rate Limiting&lt;br&gt;• API Versioning" style="shape=component;whiteSpace=wrap;html=1;fillColor=#fff2cc;" vertex="1" parent="1">
                    <mxGeometry x="950" y="220" width="180" height="140" as="geometry" />
                </mxCell>
                
                <!-- =========================================== -->
                <!-- APPLICATION ZONE COMPONENTS -->
                <!-- =========================================== -->
                
                <!-- Container Cluster -->
                <mxCell id="app_container_cluster" value="&lt;b&gt;Kubernetes Cluster&lt;/b&gt;&lt;br&gt;(Docker Containers)&lt;br&gt;-------------------&lt;br&gt;• Auto-scaling&lt;br&gt;• Service Mesh&lt;br&gt;• Rolling Updates&lt;br&gt;• Self-healing" style="shape=component;whiteSpace=wrap;html=1;fillColor=#f5f5f5;" vertex="1" parent="1">
                    <mxGeometry x="150" y="500" width="200" height="140" as="geometry" />
                </mxCell>
                
                <!-- Microservices Group -->
                <mxCell id="app_microservices" value="&lt;b&gt;Microservices&lt;/b&gt;&lt;br&gt;(Node.js/Spring Boot)&lt;br&gt;-------------------&lt;br&gt;• User Service&lt;br&gt;• Product Service&lt;br&gt;• Order Service&lt;br&gt;• Payment Service&lt;br&gt;• Notification Service" style="shape=component;whiteSpace=wrap;html=1;fillColor=#d5e8d4;" vertex="1" parent="1">
                    <mxGeometry x="400" y="500" width="200" height="140" as="geometry" />
                </mxCell>
                
                <!-- Cache Cluster -->
                <mxCell id="app_cache_cluster" value="&lt;b&gt;Redis Cluster&lt;/b&gt;&lt;br&gt;(In-memory Cache)&lt;br&gt;-------------------&lt;br&gt;• Session Store&lt;br&gt;• Product Cache&lt;br&gt;• Rate Limiting&lt;br&gt;• Queue System" style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#f8cecc;" vertex="1" parent="1">
                    <mxGeometry x="650" y="500" width="180" height="140" as="geometry" />
                </mxCell>
                
                <!-- Search Cluster -->
                <mxCell id="app_search_cluster" value="&lt;b&gt;Elasticsearch Cluster&lt;/b&gt;&lt;br&gt;(Search Engine)&lt;br&gt;-------------------&lt;br&gt;• Product Search&lt;br&gt;• Log Analytics&lt;br&gt;• Recommendations&lt;br&gt;• Autocomplete" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;" vertex="1" parent="1">
                    <mxGeometry x="880" y="500" width="180" height="140" as="geometry" />
                </mxCell>
                
                <!-- Message Queue -->
                <mxCell id="app_message_queue" value="&lt;b&gt;Message Queue&lt;/b&gt;&lt;br&gt;(Kafka/RabbitMQ)&lt;br&gt;-------------------&lt;br&gt;• Event Streaming&lt;br&gt;• Order Processing&lt;br&gt;• Notifications&lt;br&gt;• Log Aggregation" style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#fff2cc;" vertex="1" parent="1">
                    <mxGeometry x="1110" y="500" width="180" height="140" as="geometry" />
                </mxCell>
                
                <!-- =========================================== -->
                <!-- DATABASE ZONE COMPONENTS -->
                <!-- =========================================== -->
                
                <!-- Primary Database -->
                <mxCell id="db_primary" value="&lt;b&gt;Primary Database&lt;/b&gt;&lt;br&gt;(PostgreSQL)&lt;br&gt;-------------------&lt;br&gt;• Master Node&lt;br&gt;• Read/Write&lt;br&gt;• 64GB RAM&lt;br&gt;• SSD Storage" style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#dae8fc;" vertex="1" parent="1">
                    <mxGeometry x="200" y="880" width="180" height="120" as="geometry" />
                </mxCell>
                
                <!-- Replica Databases -->
                <mxCell id="db_replicas" value="&lt;b&gt;Read Replicas&lt;/b&gt;&lt;br&gt;(3 Nodes)&lt;br&gt;-------------------&lt;br&gt;• Read-only&lt;br&gt;• Load Balancing&lt;br&gt;• Failover Support&lt;br&gt;• 32GB RAM each" style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#d5e8d4;" vertex="1" parent="1">
                    <mxGeometry x="450" y="880" width="180" height="120" as="geometry" />
                </mxCell>
                
                <!-- Backup Server -->
                <mxCell id="db_backup" value="&lt;b&gt;Backup Server&lt;/b&gt;&lt;br&gt;-------------------&lt;br&gt;• Daily Backups&lt;br&gt;• Incremental&lt;br&gt;• Off-site Storage&lt;br&gt;• Disaster Recovery" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;" vertex="1" parent="1">
                    <mxGeometry x="700" y="880" width="180" height="120" as="geometry" />
                </mxCell>
                
                <!-- Object Storage -->
                <mxCell id="db_object_storage" value="&lt;b&gt;Object Storage&lt;/b&gt;&lt;br&gt;(AWS S3/MinIO)&lt;br&gt;-------------------&lt;br&gt;• Product Images&lt;br&gt;• User Files&lt;br&gt;• Backups&lt;br&gt;• CDN Origin" style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#fff2cc;" vertex="1" parent="1">
                    <mxGeometry x="950" y="880" width="180" height="120" as="geometry" />
                </mxCell>
                
                <!-- =========================================== -->
                <!-- DEPLOYMENT NODES -->
