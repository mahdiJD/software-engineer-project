                <!-- =========================================== -->
                <!-- FIREWALLS AND SECURITY -->
                <!-- =========================================== -->
                
                <!-- Firewall 1: Internet → DMZ -->
                <mxCell id="firewall1" value="&lt;b&gt;External Firewall&lt;/b&gt;&lt;br&gt;• Allow HTTPS (443)&lt;br&gt;• Allow HTTP (80) from CDN&lt;br&gt;• Deny all else" style="shape=umlFrame;whiteSpace=wrap;html=1;rounded=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
                    <mxGeometry x="100" y="140" width="300" height="80" as="geometry" />
                </mxCell>
                
                <!-- Firewall 2: DMZ → Application -->
                <mxCell id="firewall2" value="&lt;b&gt;Internal Firewall&lt;/b&gt;&lt;br&gt;• Allow specific ports&lt;br&gt;• IP whitelisting&lt;br&gt;• Traffic inspection" style="shape=umlFrame;whiteSpace=wrap;html=1;rounded=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
                    <mxGeometry x="100" y="410" width="300" height="80" as="geometry" />
                </mxCell>
                
                <!-- Firewall 3: Application → Database -->
                <mxCell id="firewall3" value="&lt;b&gt;Database Firewall&lt;/b&gt;&lt;br&gt;• Allow DB ports only&lt;br&gt;• Application IPs only&lt;br&gt;• SQL injection prevention" style="shape=umlFrame;whiteSpace=wrap;html=1;rounded=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
                    <mxGeometry x="100" y="780" width="300" height="80" as="geometry" />
