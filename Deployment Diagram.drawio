                <!-- Cloud Provider -->
                <mxCell id="node_cloud" value="&lt;b&gt;Cloud Provider&lt;/b&gt;&lt;br&gt;(AWS/Google Cloud/Azure)" style="shape=cloud;whiteSpace=wrap;html=1;fillColor=#f5f5f5;" vertex="1" parent="1">
