                    </mxGeometry>
                </mxCell>
                
                <!-- =========================================== -->
                <!-- CONNECTIONS: DMZ → APPLICATION -->
                <!-- =========================================== -->
                
                <!-- Load Balancer → Web Servers -->
                <mxCell id="conn_dmz1" value="&lt;b&gt;HTTP (80)&lt;/b&gt;" style="endArrow=open;html=1;endSize=8;" edge="1" parent="1" source="dmz_load_balancer" target="dmz_web_servers">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="380" y="290" as="sourcePoint" />
                        <mxPoint x="450" y="290" as="targetPoint" />
                    </mxGeometry>
                </mxCell>
                
                <!-- Web Servers → WAF -->
