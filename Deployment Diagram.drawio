                <!-- CONNECTIONS: INTERNET → DMZ -->
                <!-- =========================================== -->
                
                <!-- Users → Load Balancer -->
                <mxCell id="conn_internet1" value="&lt;b&gt;HTTPS (443)&lt;/b&gt;" style="endArrow=open;html=1;endSize=8;edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;" edge="1" parent="1" source="internet_users" target="dmz_load_balancer">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="120" y="150" as="sourcePoint" />
                        <mxPoint x="290" y="220" as="targetPoint" />
                    </mxGeometry>
                </mxCell>
                
                <!-- CDN → Web Servers -->
                <mxCell id="conn_internet2" value="" style="endArrow=open;html=1;endSize=8;dashed=1;" edge="1" parent="1" source="internet_cdn" target="dmz_web_servers">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="380" y="150" as="sourcePoint" />
                        <mxPoint x="540" y="220" as="targetPoint" />
                    </mxGeometry>
                </mxCell>
                
                <!-- External APIs → API Gateway -->
                <mxCell id="conn_internet3" value="&lt;b&gt;Webhook&lt;/b&gt;" style="endArrow=open;html=1;endSize=8;" edge="1" parent="1" source="internet_apis" target="dmz_api_gateway">
